<Application x:Class="Stem.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="KryptonBackgroundBrush" Color="#070A12" />
    <SolidColorBrush x:Key="KryptonPanelBrush" Color="#0C111C" />
    <SolidColorBrush x:Key="KryptonShellBrush" Color="#05070C" />
    <SolidColorBrush x:Key="KryptonTextBrush" Color="#D8DAD4" />
    <SolidColorBrush x:Key="KryptonMutedBrush" Color="#7E899B" />
    <SolidColorBrush x:Key="KryptonAccentBrush" Color="#8B5CF6" />
    <SolidColorBrush x:Key="KryptonAccentHighlightBrush" Color="#C4A7FF" />

    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Background" Value="{StaticResource KryptonBackgroundBrush}" />
      <Setter Property="Foreground" Value="{StaticResource KryptonTextBrush}" />
    </Style>

    <Style x:Key="ChromeButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#AAB4C4" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ChromeSurface"
                    Background="{TemplateBinding Background}"
                    CornerRadius="5">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ChromeSurface" Property="Background" Value="#1A2231" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ChromeSurface" Property="Background" Value="#263247" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ChromeButtonStyle}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#C63C51" />
          <Setter Property="Foreground" Value="#FFFFFF" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
