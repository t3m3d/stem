<Application x:Class="Stem.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <!-- Defaults are Krypton Dark. KryptonTheme swaps these resources at runtime. -->
    <Color x:Key="KryptonShellStartColor">#4C1D95</Color>
    <Color x:Key="KryptonShellMidColor">#6D28D9</Color>
    <Color x:Key="KryptonShellEndColor">#2E1065</Color>
    <Color x:Key="KryptonFrameStartColor">#D7C3FF</Color>
    <Color x:Key="KryptonFrameEndColor">#6D28D9</Color>
    <Color x:Key="KryptonWavePrimaryColor">#58FFFFFF</Color>
    <Color x:Key="KryptonWaveSecondaryColor">#48C4A7FF</Color>

    <SolidColorBrush x:Key="KryptonBackgroundBrush" Color="#10081D" />
    <SolidColorBrush x:Key="KryptonPanelBrush" Color="#180C2A" />
    <SolidColorBrush x:Key="KryptonShellBrush" Color="#260D46" />
    <SolidColorBrush x:Key="KryptonTerminalChromeBrush" Color="#160A2A" />
    <SolidColorBrush x:Key="KryptonFieldBrush" Color="#0B0712" />
    <SolidColorBrush x:Key="KryptonTextBrush" Color="#F0EBFA" />
    <SolidColorBrush x:Key="KryptonStrongTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="KryptonTitleTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="KryptonMutedBrush" Color="#B4A8C8" />
    <SolidColorBrush x:Key="KryptonSubtleBrush" Color="#746985" />
    <SolidColorBrush x:Key="KryptonAccentBrush" Color="#8B5CF6" />
    <SolidColorBrush x:Key="KryptonAccentHighlightBrush" Color="#D7C3FF" />
    <SolidColorBrush x:Key="KryptonBorderBrush" Color="#654698" />
    <SolidColorBrush x:Key="KryptonFrameBrush" Color="#B79AFF" />
    <SolidColorBrush x:Key="KryptonMenuBrush" Color="#160D25" />
    <SolidColorBrush x:Key="KryptonMenuHoverBrush" Color="#3A1D64" />
    <SolidColorBrush x:Key="KryptonMenuSelectedBrush" Color="#512B82" />
    <SolidColorBrush x:Key="KryptonStatusBrush" Color="#170A29" />
    <SolidColorBrush x:Key="KryptonChromeHoverBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="KryptonChromePressedBrush" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="KryptonDangerBrush" Color="#C63C51" />
    <SolidColorBrush x:Key="KryptonWarningBrush" Color="#E4B856" />
    <SolidColorBrush x:Key="KryptonSelectionBrush" Color="#3A2A60" />
    <SolidColorBrush x:Key="KryptonShadowBrush" Color="#AA000000" />
    <SolidColorBrush x:Key="KryptonWavePrimaryBrush" Color="#58FFFFFF" />
    <SolidColorBrush x:Key="KryptonWaveSecondaryBrush" Color="#48C4A7FF" />

    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource KryptonTextBrush}" />
    </Style>

    <Style x:Key="ChromeButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource KryptonTitleTextBrush}" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ChromeSurface" Background="{TemplateBinding Background}" CornerRadius="5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ChromeSurface" Property="Background" Value="{DynamicResource KryptonChromeHoverBrush}" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ChromeSurface" Property="Background" Value="{DynamicResource KryptonChromePressedBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeButtonStyle}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource KryptonDangerBrush}" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="KryptonContextMenuStyle" TargetType="{x:Type ContextMenu}">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Background" Value="{DynamicResource KryptonMenuBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource KryptonTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KryptonBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="HasDropShadow" Value="True" />
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ContextMenu}">
            <Border Margin="2" Padding="{TemplateBinding Padding}" CornerRadius="8"
                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.55" Color="#000000" />
              </Border.Effect>
              <ScrollViewer CanContentScroll="True">
                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource KryptonContextMenuStyle}" />

    <Style TargetType="{x:Type MenuItem}">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="MinWidth" Value="210" />
      <Setter Property="Height" Value="31" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource KryptonTextBrush}" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type MenuItem}">
            <Grid x:Name="MenuRoot" MinHeight="{TemplateBinding Height}"
                  Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="18" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="CheckMark" Text="✓" Visibility="Collapsed"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource KryptonAccentHighlightBrush}" />
              <ContentPresenter Grid.Column="1" Margin="4,0,12,0" VerticalAlignment="Center"
                                ContentSource="Header" RecognizesAccessKey="True" />
              <TextBlock Grid.Column="2" Margin="12,0,8,0" VerticalAlignment="Center"
                         Text="{TemplateBinding InputGestureText}" FontSize="9"
                         Foreground="{DynamicResource KryptonMutedBrush}" />
              <TextBlock x:Name="SubmenuArrow" Grid.Column="3" Text="›" Visibility="Collapsed"
                         HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"
                         Foreground="{DynamicResource KryptonAccentBrush}" />
              <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-3"
                     AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                     IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                <Border Margin="2" Padding="4" CornerRadius="8"
                        Background="{DynamicResource KryptonMenuBrush}"
                        BorderBrush="{DynamicResource KryptonBorderBrush}" BorderThickness="1">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.55" Color="#000000" />
                  </Border.Effect>
                  <ScrollViewer CanContentScroll="True">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="HasItems" Value="True">
                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="MenuRoot" Property="Background" Value="{DynamicResource KryptonMenuHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource KryptonStrongTextBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="MenuRoot" Property="Opacity" Value="0.42" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type Separator}">
      <Setter Property="Margin" Value="8,4" />
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource KryptonBorderBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Separator}">
            <Border Height="1" Background="{TemplateBinding Background}" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="Background" Value="{DynamicResource KryptonMenuBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource KryptonTextBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBoxItem}">
            <Border x:Name="ComboItemRoot" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ComboItemRoot" Property="Background" Value="{DynamicResource KryptonMenuHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource KryptonStrongTextBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ComboItemRoot" Property="Background" Value="{DynamicResource KryptonMenuSelectedBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource KryptonStrongTextBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type ToolTip}">
      <Setter Property="Padding" Value="9,6" />
      <Setter Property="Background" Value="{DynamicResource KryptonMenuBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource KryptonTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource KryptonBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="10" />
    </Style>
  </Application.Resources>
</Application>
