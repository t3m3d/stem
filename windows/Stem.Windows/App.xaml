<Application x:Class="Stem.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="KryptonBackgroundBrush" Color="#070A12" />
    <SolidColorBrush x:Key="KryptonPanelBrush" Color="#0C111C" />
    <SolidColorBrush x:Key="KryptonShellBrush" Color="#05070C" />
    <SolidColorBrush x:Key="KryptonTextBrush" Color="#D8DAD4" />
    <SolidColorBrush x:Key="KryptonMutedBrush" Color="#7E899B" />
    <SolidColorBrush x:Key="KryptonAccentBrush" Color="#8B5CF6" />
    <SolidColorBrush x:Key="KryptonAccentHighlightBrush" Color="#C4A7FF" />

    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Background" Value="{StaticResource KryptonBackgroundBrush}" />
      <Setter Property="Foreground" Value="{StaticResource KryptonTextBrush}" />
    </Style>

    <Style x:Key="ChromeButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#AAB4C4" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ChromeSurface"
                    Background="{TemplateBinding Background}"
                    CornerRadius="5">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ChromeSurface" Property="Background" Value="#1A2231" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ChromeSurface" Property="Background" Value="#263247" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ChromeButtonStyle}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#C63C51" />
          <Setter Property="Foreground" Value="#FFFFFF" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="KryptonContextMenuStyle" TargetType="{x:Type ContextMenu}">
      <Setter Property="Background" Value="#0D1420" />
      <Setter Property="Foreground" Value="#E8E2F5" />
      <Setter Property="BorderBrush" Value="#6D8B5CF6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="HasDropShadow" Value="True" />
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ContextMenu}">
            <Border Margin="2"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="8"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.55" Color="#000000" />
              </Border.Effect>
              <ScrollViewer CanContentScroll="True">
                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource KryptonContextMenuStyle}" />

    <Style TargetType="{x:Type MenuItem}">
      <Setter Property="MinWidth" Value="210" />
      <Setter Property="Height" Value="31" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#E8E2F5" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type MenuItem}">
            <Grid x:Name="MenuRoot"
                  MinHeight="{TemplateBinding Height}"
                  Background="{TemplateBinding Background}"
                  SnapsToDevicePixels="True">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="18" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="CheckMark"
                         Text="✓"
                         Visibility="Collapsed"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="#C4A7FF" />
              <ContentPresenter Grid.Column="1"
                                Margin="4,0,12,0"
                                VerticalAlignment="Center"
                                ContentSource="Header"
                                RecognizesAccessKey="True" />
              <TextBlock Grid.Column="2"
                         Margin="12,0,8,0"
                         VerticalAlignment="Center"
                         Text="{TemplateBinding InputGestureText}"
                         FontSize="9"
                         Foreground="#7E899B" />
              <TextBlock x:Name="SubmenuArrow"
                         Grid.Column="3"
                         Text="›"
                         Visibility="Collapsed"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="15"
                         Foreground="#A78BFA" />
              <Popup x:Name="PART_Popup"
                     Placement="Right"
                     HorizontalOffset="-3"
                     AllowsTransparency="True"
                     Focusable="False"
                     PopupAnimation="Fade"
                     IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                <Border Margin="2"
                        Padding="4"
                        CornerRadius="8"
                        Background="#0D1420"
                        BorderBrush="#6D8B5CF6"
                        BorderThickness="1">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.55" Color="#000000" />
                  </Border.Effect>
                  <ScrollViewer CanContentScroll="True">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="HasItems" Value="True">
                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="MenuRoot" Property="Background" Value="#2B1D4D" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="MenuRoot" Property="Opacity" Value="0.42" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type Separator}">
      <Setter Property="Margin" Value="8,4" />
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="#2B3950" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Separator}">
            <Border Height="1" Background="{TemplateBinding Background}" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="Background" Value="#0D1420" />
      <Setter Property="Foreground" Value="#E8E2F5" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBoxItem}">
            <Border x:Name="ComboItemRoot"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ComboItemRoot" Property="Background" Value="#2B1D4D" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ComboItemRoot" Property="Background" Value="#3B2568" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type ToolTip}">
      <Setter Property="Padding" Value="9,6" />
      <Setter Property="Background" Value="#131C2B" />
      <Setter Property="Foreground" Value="#E8E2F5" />
      <Setter Property="BorderBrush" Value="#5E4296" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="10" />
    </Style>
  </Application.Resources>
</Application>
