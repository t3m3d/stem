<Window x:Class="Stem.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Stem.Windows"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="STEM"
        Width="1120"
        Height="740"
        MinWidth="620"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        StateChanged="OnWindowStateChanged">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="44"
                        ResizeBorderThickness="7"
                        CornerRadius="12"
                        GlassFrameThickness="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Border x:Name="RootFrame"
          Margin="1"
          CornerRadius="12"
          BorderThickness="1"
          Background="{DynamicResource KryptonShellBrush}">
    <Border.BorderBrush>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{DynamicResource KryptonFrameStartColor}" Offset="0" />
        <GradientStop Color="{DynamicResource KryptonFrameEndColor}" Offset="0.52" />
        <GradientStop Color="{DynamicResource KryptonFrameStartColor}" Offset="1" />
      </LinearGradientBrush>
    </Border.BorderBrush>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44" />
        <RowDefinition Height="*" />
        <RowDefinition Height="0" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0"
              CornerRadius="11,11,0,0"
              MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="{DynamicResource KryptonShellStartColor}" Offset="0" />
            <GradientStop Color="{DynamicResource KryptonShellMidColor}" Offset="0.55" />
            <GradientStop Color="{DynamicResource KryptonShellEndColor}" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Two restrained vector waves make the shell distinct without touching terminal rendering. -->
          <Path Grid.ColumnSpan="3"
                Margin="-24,4,-24,-5"
                Stretch="Fill"
                IsHitTestVisible="False"
                Fill="{DynamicResource KryptonWaveSecondaryBrush}"
                Opacity="0.42"
                Data="M 0,36 C 135,4 252,58 410,25 C 566,-8 695,49 842,20 C 958,-3 1050,14 1120,5 L 1120,52 L 0,52 Z" />
          <Path Grid.ColumnSpan="3"
                Margin="-18,0,-18,1"
                Stretch="Fill"
                IsHitTestVisible="False"
                Stroke="{DynamicResource KryptonWavePrimaryBrush}"
                StrokeThickness="1.15"
                Data="M 0,34 C 132,6 268,55 420,25 C 568,-4 714,47 862,18 C 969,-3 1052,12 1120,4" />

          <StackPanel Grid.Column="0"
                      Orientation="Horizontal"
                      VerticalAlignment="Center"
                      Margin="14,0,0,0">
            <Border Width="30"
                    Height="30"
                    CornerRadius="8"
                    BorderThickness="1">
              <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="{DynamicResource KryptonFrameEndColor}" Offset="0" />
                  <GradientStop Color="{DynamicResource KryptonFrameStartColor}" Offset="1" />
                </LinearGradientBrush>
              </Border.BorderBrush>
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="{DynamicResource KryptonShellMidColor}" Offset="0" />
                  <GradientStop Color="{DynamicResource KryptonShellEndColor}" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <TextBlock Text="K"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="15"
                         FontWeight="Bold"
                         Foreground="{DynamicResource KryptonTitleTextBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="STEM"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource KryptonTitleTextBrush}" />
          </StackPanel>

          <StackPanel Grid.Column="1"
                      Margin="18,0,12,0"
                      Orientation="Horizontal"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel x:Name="TabStrip"
                        Orientation="Horizontal"
                        VerticalAlignment="Center" />
            <Button x:Name="NewTabButton"
                    Width="28"
                    Height="26"
                    Margin="5,0,0,0"
                    Padding="0"
                    Content="+"
                    ToolTip="New PowerShell tab (Ctrl+Shift+T)"
                    BorderBrush="{DynamicResource KryptonFrameBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource KryptonMenuSelectedBrush}"
                    Foreground="{DynamicResource KryptonTitleTextBrush}"
                    FontSize="15"
                    FontWeight="SemiBold"
                    FocusVisualStyle="{x:Null}"
                    Click="OnNewTabClick" />
          </StackPanel>
          <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel Margin="4,0,7,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
              <Ellipse x:Name="ConnectionDot"
                       Width="6"
                       Height="6"
                       Margin="0,0,6,0"
                       Fill="{DynamicResource KryptonWarningBrush}" />
              <TextBlock x:Name="ConnectionStatus"
                         Text="STARTING"
                         VerticalAlignment="Center"
                         FontSize="8.5"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource KryptonTitleTextBrush}" />
            </StackPanel>
            <Button Width="36"
                    Height="38"
                    Padding="0"
                    Content="&#xE70D;"
                    ToolTip="Terminal menu"
                    Style="{StaticResource ChromeButtonStyle}"
                    Click="OnSessionMenuClick">
              <Button.ContextMenu>
                <ContextMenu Background="{DynamicResource KryptonMenuBrush}"
                             FontFamily="Segoe UI"
                             Foreground="{DynamicResource KryptonTextBrush}"
                             BorderBrush="{DynamicResource KryptonBorderBrush}"
                             BorderThickness="1"
                             Padding="4">
                  <MenuItem Header="New tab"
                            InputGestureText="Ctrl+Shift+T"
                            Click="OnNewTabClick" />
                  <Separator />
                  <MenuItem Header="Split right"
                            InputGestureText="Alt+Shift+Plus"
                            Click="OnSplitRightClick" />
                  <MenuItem Header="Split down"
                            InputGestureText="Alt+Shift+Minus"
                            Click="OnSplitDownClick" />
                  <MenuItem Header="Zoom / restore pane"
                            InputGestureText="Alt+Shift+Enter"
                            Click="OnTogglePaneZoomClick" />
                  <MenuItem Header="Close pane"
                            InputGestureText="Ctrl+Shift+W"
                            Click="OnClosePaneClick" />
                  <Separator />
                  <MenuItem Header="Find"
                            InputGestureText="Ctrl+Shift+F"
                            Click="OnFindClick" />
                  <MenuItem Header="Settings..."
                            Click="OnSettingsClick" />
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
            <Button Style="{StaticResource ChromeButtonStyle}"
                    Content="&#xE921;"
                    ToolTip="Minimize"
                    Click="OnMinimizeClick" />
            <Button x:Name="MaximizeButton"
                    Style="{StaticResource ChromeButtonStyle}"
                    Content="&#xE922;"
                    ToolTip="Maximize"
                    Click="OnMaximizeClick" />
            <Button Style="{StaticResource CloseButtonStyle}"
                    Content="&#xE8BB;"
                    ToolTip="Close"
                    Click="OnCloseClick" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="2">
        <Border
                CornerRadius="10"
                BorderThickness="1"
                Background="{DynamicResource KryptonTerminalChromeBrush}">
          <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="{DynamicResource KryptonFrameStartColor}" Offset="0" />
              <GradientStop Color="{DynamicResource KryptonFrameEndColor}" Offset="0.42" />
              <GradientStop Color="{DynamicResource KryptonFrameStartColor}" Offset="1" />
            </LinearGradientBrush>
          </Border.BorderBrush>
          <Grid Margin="1">

            <Border x:Name="TerminalViewportFrame"
                    Grid.Row="0"
                    Margin="0"
                    CornerRadius="5"
                    BorderBrush="{DynamicResource KryptonBorderBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource KryptonTerminalChromeBrush}"
                    ClipToBounds="True">
              <Grid>
                <ContentControl x:Name="TerminalHost"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Background="{DynamicResource KryptonTerminalChromeBrush}" />

                <Border x:Name="SearchPanel"
                        Width="390"
                        Margin="0,8,12,0"
                        Padding="8,6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Panel.ZIndex="10"
                        Visibility="Collapsed"
                        CornerRadius="7"
                        BorderBrush="{DynamicResource KryptonAccentBrush}"
                        BorderThickness="1"
                        Background="{DynamicResource KryptonMenuBrush}">
                  <Border.Resources>
                    <Style TargetType="Button">
                      <Setter Property="Width" Value="28" />
                      <Setter Property="Height" Value="26" />
                      <Setter Property="Margin" Value="3,0,0,0" />
                      <Setter Property="Padding" Value="0" />
                      <Setter Property="BorderThickness" Value="0" />
                      <Setter Property="Background" Value="{DynamicResource KryptonMenuHoverBrush}" />
                      <Setter Property="Foreground" Value="{DynamicResource KryptonAccentHighlightBrush}" />
                      <Setter Property="FontSize" Value="12" />
                      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    </Style>
                  </Border.Resources>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="56" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox"
                             Height="26"
                             Padding="7,3"
                             VerticalContentAlignment="Center"
                             BorderBrush="{DynamicResource KryptonBorderBrush}"
                             BorderThickness="1"
                             Background="{DynamicResource KryptonTerminalChromeBrush}"
                             Foreground="{DynamicResource KryptonTitleTextBrush}"
                             CaretBrush="{DynamicResource KryptonAccentBrush}"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="11"
                             TextChanged="OnSearchTextChanged"
                             PreviewKeyDown="OnSearchBoxPreviewKeyDown" />
                    <TextBlock x:Name="SearchCount"
                               Grid.Column="1"
                               Text="0 / 0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="9"
                               Foreground="{DynamicResource KryptonMutedBrush}" />
                    <Button Grid.Column="2"
                            Content="↑"
                            ToolTip="Previous match (Shift+Enter)"
                            Click="OnSearchPreviousClick" />
                    <Button Grid.Column="3"
                            Content="↓"
                            ToolTip="Next match (Enter)"
                            Click="OnSearchNextClick" />
                    <Button Grid.Column="4"
                            Content="×"
                            ToolTip="Close find (Esc)"
                            Click="OnSearchCloseClick" />
                  </Grid>
                </Border>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="2"
              Visibility="Collapsed"
              BorderBrush="{DynamicResource KryptonBorderBrush}"
              BorderThickness="0,1,0,0"
              Background="{DynamicResource KryptonStatusBrush}"
              CornerRadius="0,0,11,11">
        <Grid Margin="14,0" ClipToBounds="True">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Path Grid.ColumnSpan="3"
                Margin="-16,0,-16,-5"
                Stretch="Fill"
                IsHitTestVisible="False"
                Fill="{DynamicResource KryptonWaveSecondaryBrush}"
                Opacity="0.28"
                Data="M 0,26 C 170,8 305,34 470,18 C 635,2 812,32 980,14 C 1030,8 1080,8 1120,5 L 1120,36 L 0,36 Z" />
          <Path Grid.ColumnSpan="3"
                Margin="-16,0,-16,0"
                Stretch="Fill"
                IsHitTestVisible="False"
                Stroke="{DynamicResource KryptonWavePrimaryBrush}"
                StrokeThickness="0.8"
                Opacity="0.6"
                Data="M 0,24 C 168,7 314,32 478,17 C 642,2 814,30 986,13 C 1034,8 1081,7 1120,5" />
          <TextBlock x:Name="ScrollbackStatus"
                     Grid.Column="1"
                     Text="LIVE"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontSize="8"
                     Foreground="{DynamicResource KryptonSubtleBrush}" />
          <TextBlock x:Name="TerminalDimensions"
                     Grid.Column="2"
                     Text="120 × 40"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="9"
                     Foreground="{DynamicResource KryptonMutedBrush}" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
