<Window x:Class="Stem.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Stem.Windows"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="STEM"
        Width="1120"
        Height="740"
        MinWidth="620"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#070A12"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        StateChanged="OnWindowStateChanged">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="52"
                        ResizeBorderThickness="7"
                        CornerRadius="12"
                        GlassFrameThickness="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Border x:Name="RootFrame"
          Margin="1"
          CornerRadius="12"
          BorderThickness="1"
          Background="#070A12">
    <Border.BorderBrush>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4C8B5CF6" Offset="0" />
        <GradientStop Color="#208B5CF6" Offset="0.5" />
        <GradientStop Color="#3C2A354A" Offset="1" />
      </LinearGradientBrush>
    </Border.BorderBrush>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="52" />
        <RowDefinition Height="*" />
        <RowDefinition Height="36" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0"
              CornerRadius="11,11,0,0"
              MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#111829" Offset="0" />
            <GradientStop Color="#0C111C" Offset="0.55" />
            <GradientStop Color="#090D16" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0"
                      Orientation="Horizontal"
                      VerticalAlignment="Center"
                      Margin="14,0,0,0">
            <Border Width="30"
                    Height="30"
                    CornerRadius="8"
                    BorderThickness="1">
              <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#8B5CF6" Offset="0" />
                  <GradientStop Color="#C4A7FF" Offset="1" />
                </LinearGradientBrush>
              </Border.BorderBrush>
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#2B1D4D" Offset="0" />
                  <GradientStop Color="#1D1533" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <TextBlock Text="K"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="15"
                         FontWeight="Bold"
                         Foreground="#F4F7FF"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="STEM"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#F0F3F8" />
          </StackPanel>

          <Border Grid.Column="1"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Padding="12,5"
                  CornerRadius="12"
                  BorderBrush="#273248"
                  BorderThickness="1"
                  Background="#88080C14">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="6"
                       Height="6"
                       Margin="0,0,7,0"
                       VerticalAlignment="Center"
                       Fill="#8B5CF6" />
              <TextBlock x:Name="WindowSessionTitle"
                         Text="PowerShell"
                         MaxWidth="420"
                         TextTrimming="CharacterEllipsis"
                         FontSize="11"
                         Foreground="#AEB8C8" />
            </StackPanel>
          </Border>

          <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource ChromeButtonStyle}"
                    Content="&#xE921;"
                    ToolTip="Minimize"
                    Click="OnMinimizeClick" />
            <Button x:Name="MaximizeButton"
                    Style="{StaticResource ChromeButtonStyle}"
                    Content="&#xE922;"
                    ToolTip="Maximize"
                    Click="OnMaximizeClick" />
            <Button Style="{StaticResource CloseButtonStyle}"
                    Content="&#xE8BB;"
                    ToolTip="Close"
                    Click="OnCloseClick" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="12,7,12,7">
        <Border
                CornerRadius="10"
                BorderThickness="1"
                Background="#05070C">
          <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#6D8B5CF6" Offset="0" />
              <GradientStop Color="#3240546B" Offset="0.42" />
              <GradientStop Color="#6D8B5CF6" Offset="1" />
            </LinearGradientBrush>
          </Border.BorderBrush>
          <Grid Margin="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="30" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    CornerRadius="8,8,0,0"
                    BorderBrush="#1F2A3B"
                    BorderThickness="0,0,0,1"
                    Background="#0C121E">
              <Grid Margin="11,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Padding="8,3"
                          CornerRadius="9"
                          BorderBrush="#5E4296"
                          BorderThickness="1"
                          Background="#1D1533">
                    <TextBlock x:Name="ShellBadge"
                               Text="POWERSHELL"
                               FontSize="8.5"
                               FontWeight="Bold"
                               Foreground="#C4A7FF" />
                  </Border>
                  <TextBlock Text="  /  LOCAL SESSION"
                             VerticalAlignment="Center"
                             FontSize="8.5"
                             Foreground="#606C7E" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="14,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                  <StackPanel x:Name="TabStrip"
                              Orientation="Horizontal"
                              VerticalAlignment="Center" />
                  <Button x:Name="NewTabButton"
                          Width="28"
                          Height="24"
                          Margin="5,0,0,0"
                          Padding="0"
                          Content="+"
                          ToolTip="New PowerShell tab (Ctrl+Shift+T)"
                          BorderBrush="#4C8B5CF6"
                          BorderThickness="1"
                          Background="#1D1533"
                          Foreground="#C4A7FF"
                          FontSize="15"
                          FontWeight="SemiBold"
                          FocusVisualStyle="{x:Null}"
                          Click="OnNewTabClick" />
                  <Button Width="28"
                          Height="24"
                          Margin="5,0,0,0"
                          Padding="0"
                          Content="⌄"
                          ToolTip="Terminal options"
                          BorderBrush="#33415A"
                          BorderThickness="1"
                          Background="#101827"
                          Foreground="#C4A7FF"
                          FontSize="12"
                          FocusVisualStyle="{x:Null}"
                          Click="OnSessionMenuClick">
                    <Button.ContextMenu>
                      <ContextMenu Background="#0D1420"
                                   Foreground="#D8DAD4"
                                   BorderBrush="#5E4296"
                                   BorderThickness="1"
                                   Padding="4">
                        <MenuItem Header="New tab"
                                  InputGestureText="Ctrl+Shift+T"
                                  Click="OnNewTabClick" />
                        <Separator />
                        <MenuItem Header="Split right"
                                  InputGestureText="Alt+Shift+Plus"
                                  Click="OnSplitRightClick" />
                        <MenuItem Header="Split down"
                                  InputGestureText="Alt+Shift+Minus"
                                  Click="OnSplitDownClick" />
                        <MenuItem Header="Zoom / restore pane"
                                  InputGestureText="Alt+Shift+Enter"
                                  Click="OnTogglePaneZoomClick" />
                        <MenuItem Header="Close pane"
                                  InputGestureText="Ctrl+Shift+W"
                                  Click="OnClosePaneClick" />
                        <Separator />
                        <MenuItem Header="Find"
                                  InputGestureText="Ctrl+Shift+F"
                                  Click="OnFindClick" />
                        <MenuItem Header="Settings..."
                                  Click="OnSettingsClick" />
                      </ContextMenu>
                    </Button.ContextMenu>
                  </Button>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                  <Ellipse x:Name="ConnectionDot"
                           Width="6"
                           Height="6"
                           Margin="0,0,7,0"
                           Fill="#E4B856" />
                  <TextBlock x:Name="ConnectionStatus"
                             Text="STARTING"
                             FontSize="8.5"
                             FontWeight="SemiBold"
                             Foreground="#8D98A9" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="5"
                    CornerRadius="5"
                    BorderBrush="#152033"
                    BorderThickness="1"
                    Background="#05070C"
                    ClipToBounds="True">
              <Grid>
                <ContentControl x:Name="TerminalHost"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Background="#05070C" />

                <Border x:Name="SearchPanel"
                        Width="390"
                        Margin="0,8,12,0"
                        Padding="8,6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Panel.ZIndex="10"
                        Visibility="Collapsed"
                        CornerRadius="7"
                        BorderBrush="#6D8B5CF6"
                        BorderThickness="1"
                        Background="#F20C111C">
                  <Border.Resources>
                    <Style TargetType="Button">
                      <Setter Property="Width" Value="28" />
                      <Setter Property="Height" Value="26" />
                      <Setter Property="Margin" Value="3,0,0,0" />
                      <Setter Property="Padding" Value="0" />
                      <Setter Property="BorderThickness" Value="0" />
                      <Setter Property="Background" Value="#182235" />
                      <Setter Property="Foreground" Value="#C4A7FF" />
                      <Setter Property="FontSize" Value="12" />
                      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    </Style>
                  </Border.Resources>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="56" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox"
                             Height="26"
                             Padding="7,3"
                             VerticalContentAlignment="Center"
                             BorderBrush="#3B4A62"
                             BorderThickness="1"
                             Background="#05070C"
                             Foreground="#F0F3F8"
                             CaretBrush="#8B5CF6"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="11"
                             TextChanged="OnSearchTextChanged"
                             PreviewKeyDown="OnSearchBoxPreviewKeyDown" />
                    <TextBlock x:Name="SearchCount"
                               Grid.Column="1"
                               Text="0 / 0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="9"
                               Foreground="#7F8A9D" />
                    <Button Grid.Column="2"
                            Content="↑"
                            ToolTip="Previous match (Shift+Enter)"
                            Click="OnSearchPreviousClick" />
                    <Button Grid.Column="3"
                            Content="↓"
                            ToolTip="Next match (Enter)"
                            Click="OnSearchNextClick" />
                    <Button Grid.Column="4"
                            Content="×"
                            ToolTip="Close find (Esc)"
                            Click="OnSearchCloseClick" />
                  </Grid>
                </Border>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="2"
              BorderBrush="#182235"
              BorderThickness="0,1,0,0"
              Background="#090E17"
              CornerRadius="0,0,11,11">
        <Grid Margin="14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="ScrollbackStatus"
                     Grid.Column="1"
                     Text="LIVE"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontSize="8"
                     Foreground="#3F4B5E" />
          <TextBlock x:Name="TerminalDimensions"
                     Grid.Column="2"
                     Text="120 × 40"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="9"
                     Foreground="#758196" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
